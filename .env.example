# Copy to the Git-ignored .env.local and fill in the values there. Never put a real key in this file.
# Bedrock API key issued by the administrator (value goes only in .env.local).
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=ap-northeast-1
# Allowed model IDs: jp.anthropic.claude-haiku-5-5 and jp.anthropic.claude-opus-5-5
BEDROCK_GENERATION_MODEL_ID=
BEDROCK_VERIFICATION_MODEL_ID=
# Optional: leave empty because no embedding model is issued.
BEDROCK_EMBEDDING_MODEL_ID=
BEDROCK_CROSS_REGION=false
