{
  "name": "ehime-vote-navigator",
  "version": "0.0.0",
  "private": true,
  "description": "Local-only demonstration for the 2022 20th Ehime gubernatorial election",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "packages/contracts",
    "packages/domain",
    "packages/fixtures",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "supertest": "7.3.1",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
