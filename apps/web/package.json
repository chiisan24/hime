{
  "name": "@ehime-vote-navigator/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:analyst": "vite --mode analyst --host 127.0.0.1",
    "preview": "node ./scripts/preview.mjs visitor",
    "preview:analyst": "node ./scripts/preview.mjs analyst",
    "lint": "eslint src vite.config.ts scripts --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. apps/web/src",
    "build": "vite build",
    "build:analyst": "vite build --mode analyst",
    "check:build-boundary": "node ./scripts/check-build-boundary.mjs"
  },
  "dependencies": {
    "lucide-react": "1.69.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5"
  }
}
